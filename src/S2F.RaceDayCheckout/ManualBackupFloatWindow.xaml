<Window x:Class="S2F.RaceDayCheckout.ManualBackupFloatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:S2F.RaceDayCheckout"
        Title="Manual Backup"
        Width="340" Height="448"
        MinWidth="300" MinHeight="420"
        WindowStartupLocation="Manual"
        WindowStyle="ToolWindow"
        Topmost="True"
        ShowInTaskbar="True"
        ShowActivated="True"
        Background="{StaticResource BgBrush}">
  <!--
    Height / MinHeight sized so chrome + Last 5 (5×31) always fit without clipping.
    Same Entry window for Main Timing and Manual Backup Laptop.
  -->
  <DockPanel Margin="12">
    <TextBlock DockPanel.Dock="Top" Text="Manual Backup" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <local:ManualBackupEntryPanel x:Name="EntryPanel" ShowOpenStatus="True"/>
  </DockPanel>
</Window>
