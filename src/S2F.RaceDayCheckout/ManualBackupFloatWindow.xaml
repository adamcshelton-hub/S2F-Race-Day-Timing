<Window x:Class="S2F.RaceDayCheckout.ManualBackupFloatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manual Backup"
        Width="360" Height="420"
        WindowStyle="ToolWindow"
        Topmost="True"
        ShowInTaskbar="True"
        Background="#F7F8FA">
  <DockPanel Margin="12">
    <TextBlock DockPanel.Dock="Top" Text="Manual Backup" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <TextBlock DockPanel.Dock="Top" Text="{Binding OpenStatusText}" FontSize="12" Foreground="#666" Margin="0,0,0,10"/>
    <TextBlock DockPanel.Dock="Top" Text="Location" FontSize="12" Margin="0,0,0,4"/>
    <ComboBox DockPanel.Dock="Top" x:Name="LocationBox" Margin="0,0,0,10"
              DisplayMemberPath="Location" SelectedValuePath="Location"/>
    <TextBlock DockPanel.Dock="Top" Text="Bib #" FontSize="12" Margin="0,0,0,4"/>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <Button DockPanel.Dock="Right" Content="Submit" Width="88" Margin="8,0,0,0" Click="Submit_Click"
              IsDefault="True"/>
      <TextBox x:Name="BibBox" FontSize="22" Padding="8,6"/>
    </DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="Last 5 (This Device)" FontSize="12" Margin="0,0,0,4"/>
    <ListBox x:Name="RecentList" Margin="0,0,0,8">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Undo" Padding="8,2" Click="Undo_Click" Tag="{Binding}"/>
            <TextBlock VerticalAlignment="Center">
              <Run Text="{Binding Bib, Mode=OneWay}"/>
              <Run Text=" · "/>
              <Run Text="{Binding Location, Mode=OneWay}"/>
            </TextBlock>
          </DockPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <TextBlock DockPanel.Dock="Bottom" x:Name="StatusText" FontSize="12" Foreground="#555" TextWrapping="Wrap"/>
  </DockPanel>
</Window>
