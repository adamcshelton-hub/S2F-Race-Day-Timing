<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- windows10 TFM enables TaskbarManager pin prompt (WinRT) -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>S2F.RaceDayCheckout</RootNamespace>
    <AssemblyName>S2F.RaceDayCheckout</AssemblyName>
    <Version>0.5.14</Version>
    <InformationalVersion>0.5.14</InformationalVersion>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Velopack: custom Main before WPF startup -->
    <StartupObject>S2F.RaceDayCheckout.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\S2F.RaceDayCheckout.Core\S2F.RaceDayCheckout.Core.csproj" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.67.2" />
    <PackageReference Include="Microsoft.Identity.Client.Desktop" Version="4.67.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <Resource Include="Assets\logo-mark.png" />
  </ItemGroup>
</Project>
