<Window x:Class="S2F.RaceDayCheckout.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:S2F.RaceDayCheckout.Converters"
        Title="S2F Race Day"
        Icon="pack://application:,,,/Assets/logo-mark.png"
        Height="720" Width="920"
        MinHeight="560" MinWidth="720"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
  <Window.Resources>
    <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
  </Window.Resources>

  <Grid>
    <DockPanel>
      <!-- Header: orange 2 mark + product title; New event link only on office step -->
      <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" Padding="20,14">
        <DockPanel LastChildFill="True">
          <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="14"
                     Visibility="{Binding ShowNewEventLink, Converter={StaticResource BoolVis}}">
            <Hyperlink Click="NewEvent_Click" Foreground="{StaticResource AccentBrush}"
                       TextDecorations="Underline" Cursor="Hand"
                       ToolTip="Copy a Template or Past Race and set race name, date, and %resultsid%.">
              Set Up a New Event
            </Hyperlink>
          </TextBlock>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                      MouseLeftButtonDown="Logo_MouseLeftButtonDown"
                      ToolTip="Triple-click logo for admin settings">
            <Image Source="pack://application:,,,/Assets/logo-mark.png"
                   Width="40" Height="40" Stretch="Uniform" Margin="0,0,14,0"
                   SnapsToDevicePixels="True"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="Start 2 Finish Race Day Timing"
                       Foreground="White" FontSize="20" FontWeight="Bold"
                       VerticalAlignment="Center"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Body -->
      <Grid Margin="28,24">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
          <TextBlock Text="{Binding StepTitle}" FontSize="28" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding StepSubtitle}" Foreground="{StaticResource MutedBrush}"
                     FontSize="15" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- OFFICE — OneDrive ready check + office list -->
        <DockPanel Grid.Row="1"
                   Visibility="{Binding IsOfficeStep, Converter={StaticResource BoolVis}}">
          <Border DockPanel.Dock="Top" CornerRadius="8" Padding="14,12" Margin="0,0,0,14"
                  BorderThickness="1"
                  Background="{Binding GraphReadyBannerBackground}"
                  BorderBrush="{Binding GraphReadyBannerBorder}">
            <DockPanel LastChildFill="True">
              <TextBlock DockPanel.Dock="Left" FontWeight="SemiBold" FontSize="14"
                         VerticalAlignment="Center" Margin="0,0,12,0"
                         Text="{Binding GraphReadyLabel}"/>
              <TextBlock Text="{Binding GraphLandingStatus}" FontSize="14" TextWrapping="Wrap"
                         VerticalAlignment="Center"/>
            </DockPanel>
          </Border>
          <ListBox x:Name="OfficeList"
                   Style="{StaticResource StepListBox}"
                   ItemsSource="{Binding Offices}"
                   MouseDoubleClick="Office_DoubleClick">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <!-- SESSION / EVENT -->
        <Grid Grid.Row="1" Visibility="{Binding IsSessionStep, Converter={StaticResource BoolVis}}">
          <ListBox x:Name="SessionList"
                   Style="{StaticResource StepListBox}"
                   ItemsSource="{Binding Sessions}"
                   SelectedItem="{Binding SelectedSession}"
                   Visibility="{Binding HasSessions, Converter={StaticResource BoolVis}}"
                   MouseDoubleClick="Session_DoubleClick">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding PrimaryEventFile}" Foreground="{StaticResource MutedBrush}"
                               FontSize="11" Margin="0,1,0,0"/>
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding DisplayLock}" VerticalAlignment="Center"
                             Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="12,0,0,0"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480"
                      Visibility="{Binding ShowEmptySessions, Converter={StaticResource BoolVis}}">
            <TextBlock Text="No events loaded for this office"
                       FontSize="20" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock Margin="0,10,0,18" FontSize="14" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{StaticResource MutedBrush}"
                       Text="Nothing listed for this folder yet (empty on OneDrive, or the list timed out). Go Back, or Refresh events."/>
            <Button Content="Refresh events" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Center" MinWidth="200" Click="RefreshSessions_Click"
                    ToolTip="Re-list this office from OneDrive (adds new events, drops ones moved to Past Races)."/>
          </StackPanel>
        </Grid>

        <!-- EVENT FILE PICKER -->
        <DockPanel Grid.Row="1" Visibility="{Binding IsEventFileStep, Converter={StaticResource BoolVis}}">
          <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,14"
                     Foreground="{StaticResource MutedBrush}" FontSize="15"
                     Text="More than one Timing &amp; Scoring file was found. Tap the main timing file for this race (not the announcer file)."/>
          <ListBox x:Name="EventFileList" Style="{StaticResource StepListBox}"
                   ItemsSource="{Binding EventFiles}"
                   SelectedItem="{Binding SelectedEventFile}"
                   MouseDoubleClick="EventFile_DoubleClick">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" FontSize="15"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <!-- ACTIVE — event name is already in the page title; card is actions only -->
        <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="10"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="28"
                Visibility="{Binding IsActiveStep, Converter={StaticResource BoolVis}}">
          <StackPanel>
            <UniformGrid Columns="2" Margin="0,0,0,12">
              <Button Content="Open RunScore" Style="{StaticResource PrimaryButton}"
                      Margin="0,0,8,8" Click="LaunchRunScore_Click"/>
              <Button Content="Open Timing &amp; Scoring" Style="{StaticResource PrimaryButton}"
                      Margin="8,0,0,8" Click="LaunchTs_Click"/>
            </UniformGrid>

            <Button Content="Browse race files" Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Left" Margin="0,0,0,28" Click="OpenWorkingFolder_Click"
                    ToolTip="Opens the local working copy of this race if you need to find a file."/>

            <Border Background="#FFF8E8" BorderBrush="#E6C35C" BorderThickness="1"
                    CornerRadius="8" Padding="16" Margin="0,0,0,12">
              <TextBlock TextWrapping="Wrap" FontSize="14"
                         Text="Keep this app open for the whole race. It copies live RunScore files to OneDrive every minute so a second laptop can take over if this one fails."/>
            </Border>

            <Border Background="#F3FBF6" BorderBrush="{StaticResource SaveBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16" Margin="0,0,0,16">
              <TextBlock TextWrapping="Wrap" FontSize="14"
                         Text="When you're done: close RunScore and Timing &amp; Scoring, then tap Finish below. Finish clears the live autosave folder so post-race edits on OneDrive stay clean."/>
            </Border>

            <Button Content="Finish" Style="{StaticResource SaveButton}"
                    HorizontalAlignment="Stretch" FontSize="18" MinHeight="56" Click="Finish_Click"/>
          </StackPanel>
        </Border>

        <!-- ADMIN — Graph + SOP only (paths fixed under C:\S2F) -->
        <DockPanel Grid.Row="1" LastChildFill="True"
                   Visibility="{Binding IsAdminStep, Converter={StaticResource BoolVis}}">
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Edit RunScore SOP…" Style="{StaticResource SecondaryButton}"
                    Width="180" Margin="0,0,12,0" Click="EditRunScoreSop_Click"/>
            <Button Content="Save" Style="{StaticResource PrimaryButton}"
                    Width="140" Click="SaveAdmin_Click"/>
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        Padding="0,0,4,8">
            <StackPanel>
              <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,0,0,16"
                         Text="Library and race-day folders are fixed at C:\S2F\Library and C:\S2F\RaceDay (Graph cache + Active). New events: use the link on the office screen."/>

              <TextBlock Text="OneDrive" Margin="0,0,0,4" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding GraphAccountStatus}" TextWrapping="Wrap" Margin="0,0,0,8" FontSize="13"/>
              <TextBlock Text="Cloud subfolder for the library (leave blank if offices are under My files)" Margin="0,0,0,4"
                         Foreground="{StaticResource MutedBrush}" FontSize="12"/>
              <TextBox Text="{Binding GraphDriveRoot, UpdateSourceTrigger=PropertyChanged}" Padding="10,8"
                       Margin="0,0,0,12" ToolTip="Blank = OneDrive My files root (Atlanta, Test Office, …). Only fill in if offices live inside a subfolder."/>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="Sign in to OneDrive" Style="{StaticResource PrimaryButton}"
                        MinHeight="40" Width="180" Margin="0,0,12,0" Click="GraphSignIn_Click"/>
                <Button Content="Sign out" Style="{StaticResource SecondaryButton}"
                        MinHeight="40" Width="120" Margin="0,0,12,0" Click="GraphSignOut_Click"/>
                <Button Content="Refresh offices" Style="{StaticResource SecondaryButton}"
                        MinHeight="40" Width="150" Click="GraphRefresh_Click"
                        ToolTip="List offices/sessions from OneDrive into C:\S2F\Library"/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>

        <!-- Bottom actions + status (updates / library hints) -->
        <DockPanel Grid.Row="2" Margin="0,18,0,0" LastChildFill="True">
          <Button DockPanel.Dock="Left" Content="Back" Style="{StaticResource SecondaryButton}"
                  Width="120" Margin="0,0,12,0" Click="Back_Click"
                  Visibility="{Binding ShowBack, Converter={StaticResource BoolVis}}"/>

          <Button DockPanel.Dock="Right" Content="Continue" Style="{StaticResource PrimaryButton}"
                  Width="160" Margin="12,0,0,0" Click="OfficeContinue_Click"
                  Visibility="{Binding IsOfficeStep, Converter={StaticResource BoolVis}}"/>
          <Button DockPanel.Dock="Right" Content="Continue" Style="{StaticResource PrimaryButton}"
                  Width="160" Margin="12,0,0,0" Click="SessionContinue_Click"
                  Visibility="{Binding IsSessionStep, Converter={StaticResource BoolVis}}"/>
          <Button DockPanel.Dock="Right" Content="Refresh events" Style="{StaticResource SecondaryButton}"
                  Width="150" Margin="12,0,0,0" Click="RefreshSessions_Click"
                  Visibility="{Binding IsSessionStep, Converter={StaticResource BoolVis}}"
                  ToolTip="Re-list this office from OneDrive only — new events in, moved/Past Races events out."/>
          <Button DockPanel.Dock="Right" Content="Load event" Style="{StaticResource PrimaryButton}"
                  Width="160" Margin="12,0,0,0" Click="EventFileContinue_Click"
                  Visibility="{Binding IsEventFileStep, Converter={StaticResource BoolVis}}"/>
          <Button DockPanel.Dock="Right" Content="Check for updates" Style="{StaticResource SecondaryButton}"
                  Width="160" Margin="12,0,0,0" Click="CheckUpdates_Click"
                  Visibility="{Binding ShowCheckForUpdates, Converter={StaticResource BoolVis}}"
                  ToolTip="Download the latest S2F Race Day build when Wi‑Fi is available."/>

          <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}"
                     FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"
                     Margin="0,0,12,0"/>
        </DockPanel>
      </Grid>
    </DockPanel>

    <!-- Full-window busy / result overlay (no second Windows MessageBox) -->
    <Grid Visibility="{Binding Busy, Converter={StaticResource BoolVis}}" Panel.ZIndex="100">
      <Border Background="#E6000000"/>
      <Border Background="{StaticResource CardBrush}" CornerRadius="12"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Padding="40,36" MinWidth="420" MaxWidth="520"
              BorderBrush="{StaticResource AccentBrush}" BorderThickness="3">
        <StackPanel>
          <TextBlock Text="{Binding BusyTitle}" FontSize="26" FontWeight="Bold"
                     TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,14"/>
          <TextBlock Text="{Binding ProgressText}" FontSize="16"
                     Foreground="{StaticResource MutedBrush}"
                     TextAlignment="Center" TextWrapping="Wrap" LineHeight="24"/>
          <ProgressBar Height="6" Margin="0,22,0,0" IsIndeterminate="True"
                       Visibility="{Binding BusyKeepOpenVisible, Converter={StaticResource BoolVis}}"/>
          <TextBlock Text="Keep this window open — do not shut down yet." FontSize="14" FontWeight="SemiBold"
                     Foreground="{StaticResource AccentBrush}"
                     TextAlignment="Center" Margin="0,16,0,0"
                     Visibility="{Binding BusyKeepOpenVisible, Converter={StaticResource BoolVis}}"/>
          <Button Content="OK" Style="{StaticResource PrimaryButton}"
                  HorizontalAlignment="Stretch" Margin="0,28,0,0" MinHeight="52"
                  Visibility="{Binding BusyNeedsAcknowledge, Converter={StaticResource BoolVis}}"
                  Click="BusyOk_Click"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
