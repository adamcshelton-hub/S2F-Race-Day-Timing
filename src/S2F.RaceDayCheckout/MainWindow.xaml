<Window x:Class="S2F.RaceDayCheckout.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:S2F.RaceDayCheckout.Converters"
        xmlns:ctrl="clr-namespace:S2F.RaceDayCheckout.Controls"
        Title="S2F Race Day"
        Icon="pack://application:,,,/Assets/logo-mark.png"
        Height="720" Width="920"
        MinHeight="560" MinWidth="720"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
  <Window.Resources>
    <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
    <Style x:Key="FooterPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Padding" Value="14,6"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style x:Key="FooterSecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style x:Key="FooterSaveButton" TargetType="Button" BasedOn="{StaticResource SaveButton}">
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Padding" Value="14,6"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <DataTemplate x:Key="RaceStartClockTile">
                          <Grid Margin="3" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                            <Border Background="#FAFBFD" BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="6,4"
                                    VerticalAlignment="Stretch" ClipToBounds="True">
                              <Viewbox Stretch="Uniform"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <DockPanel Width="200" LastChildFill="True" Margin="0,4,0,0">
                                    <Button DockPanel.Dock="Bottom" Content="Capture Gun Start"
                                            Style="{StaticResource PrimaryButton}"
                                            FontSize="12" Padding="8,4" MinHeight="28"
                                            HorizontalAlignment="Stretch" Margin="0,4,0,0"
                                            ToolTip="Sets the actual race start from the laptop clock right now (HH:MM:SS.ff). Category label and typed Start Time are optional. Live clock counts from this gun time."
                                            Click="CaptureGunStart_Click"/>
                                    <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0" MinHeight="26"
                                               LastChildFill="True">
                                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                  VerticalAlignment="Center" Margin="6,0,0,0"
                                                  Visibility="{Binding HasGunStart, Converter={StaticResource BoolVis}}">
                                        <Button Content="&#xE8C8;" Style="{StaticResource IconToolButton}"
                                                Width="24" Height="24" MinWidth="24" MinHeight="24"
                                                FontSize="11" Margin="0,0,4,0"
                                                ToolTip="Copy Gun Time"
                                                Click="CopyGunStart_Click"/>
                                        <Button Content="&#xE74D;" ToolTip="Clear Gun Start"
                                                Click="ClearGunStart_Click">
                                          <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource IconToolButton}">
                                              <Setter Property="Width" Value="24"/>
                                              <Setter Property="Height" Value="24"/>
                                              <Setter Property="MinWidth" Value="24"/>
                                              <Setter Property="MinHeight" Value="24"/>
                                              <Setter Property="FontSize" Value="11"/>
                                              <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                            </Style>
                                          </Button.Style>
                                        </Button>
                                      </StackPanel>
                                      <TextBlock Text="{Binding GunStartDisplay}"
                                                 FontSize="13" FontWeight="SemiBold"
                                                 FontFamily="Consolas, Cascadia Mono, Courier New"
                                                 Foreground="{StaticResource SaveBrush}"
                                                 VerticalAlignment="Center"
                                                 TextWrapping="NoWrap"/>
                                    </DockPanel>
                                    <StackPanel>
                                      <TextBlock Text="Category" FontSize="10" FontWeight="SemiBold"
                                                 Foreground="{StaticResource MutedBrush}"
                                                 HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                      <Grid>
                                        <TextBox Text="{Binding CategoryText, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="13" FontWeight="SemiBold"
                                                 TextAlignment="Center" Padding="4,2"
                                                 Background="White" BorderBrush="{StaticResource LineBrush}"
                                                 BorderThickness="1" CaretBrush="{StaticResource AccentBrush}"
                                                 ToolTip="Category name (e.g. 5K)"
                                                 Tag="Category"
                                                 LostFocus="RaceStartClockField_LostFocus"
                                                 KeyDown="RaceStartClockField_KeyDown"/>
                                        <TextBlock Text="e.g. 5K" FontSize="13"
                                                   Foreground="{StaticResource PlaceholderBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   IsHitTestVisible="False">
                                          <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                              <Setter Property="Visibility" Value="Collapsed"/>
                                              <Style.Triggers>
                                                <DataTrigger Binding="{Binding CategoryText}" Value="">
                                                  <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                              </Style.Triggers>
                                            </Style>
                                          </TextBlock.Style>
                                        </TextBlock>
                                      </Grid>
                                      <TextBlock Text="{Binding LiveDisplay}"
                                                 FontSize="24" FontWeight="Bold" Margin="0,2,0,2"
                                                 FontFamily="Consolas, Cascadia Mono, Courier New"
                                                 HorizontalAlignment="Center"
                                                 IsHitTestVisible="False">
                                        <TextBlock.Style>
                                          <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                            <Style.Triggers>
                                              <DataTrigger Binding="{Binding IsCountUp}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource SaveBrush}"/>
                                              </DataTrigger>
                                            </Style.Triggers>
                                          </Style>
                                        </TextBlock.Style>
                                      </TextBlock>
                                      <TextBlock Text="Start Time (24h)" FontSize="10" FontWeight="SemiBold"
                                                 Foreground="{StaticResource MutedBrush}"
                                                 HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                      <Border Background="White" BorderThickness="1" Padding="2,1"
                                              HorizontalAlignment="Stretch"
                                              PreviewMouseLeftButtonDown="RaceStartTimeArea_PreviewMouseLeftButtonDown">
                                        <Border.Style>
                                          <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                                            <Style.Triggers>
                                              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                              </Trigger>
                                            </Style.Triggers>
                                          </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                          <Grid Width="36">
                                            <TextBox Text="{Binding StartHourText, UpdateSourceTrigger=PropertyChanged}"
                                                     MaxLength="2"
                                                     FontSize="18" FontWeight="SemiBold"
                                                     FontFamily="Consolas, Cascadia Mono, Courier New"
                                                     TextAlignment="Center" Padding="2,2"
                                                     BorderThickness="0" Background="Transparent"
                                                     CaretBrush="{StaticResource AccentBrush}"
                                                     ToolTip="Hours (00–23)"
                                                     Tag="StartHour"
                                                     GotFocus="RaceStartHour_GotFocus"
                                                     PreviewTextInput="RaceStartTimeDigit_PreviewTextInput"
                                                     PreviewKeyDown="RaceStartHour_PreviewKeyDown"
                                                     TextChanged="RaceStartHour_TextChanged"
                                                     LostFocus="RaceStartClockField_LostFocus"
                                                     KeyDown="RaceStartClockField_KeyDown"/>
                                            <TextBlock Text="00" FontSize="18" FontWeight="SemiBold"
                                                       FontFamily="Consolas, Cascadia Mono, Courier New"
                                                       Foreground="{StaticResource PlaceholderBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       IsHitTestVisible="False"
                                                       Visibility="{Binding ShowStartHourPlaceholder, Converter={StaticResource BoolVis}}"/>
                                          </Grid>
                                          <TextBlock FontSize="18" FontWeight="SemiBold"
                                                     FontFamily="Consolas, Cascadia Mono, Courier New"
                                                     VerticalAlignment="Center" Margin="2,0"
                                                     IsHitTestVisible="False">
                                            <TextBlock.Style>
                                              <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value=":"/>
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                <Style.Triggers>
                                                  <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                      <Condition Binding="{Binding ShowStartHourPlaceholder}" Value="True"/>
                                                      <Condition Binding="{Binding ShowStartMinutePlaceholder}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Foreground" Value="{StaticResource PlaceholderBrush}"/>
                                                  </MultiDataTrigger>
                                                </Style.Triggers>
                                              </Style>
                                            </TextBlock.Style>
                                          </TextBlock>
                                          <Grid Width="36">
                                            <TextBox Text="{Binding StartMinuteText, UpdateSourceTrigger=PropertyChanged}"
                                                     MaxLength="2"
                                                     FontSize="18" FontWeight="SemiBold"
                                                     FontFamily="Consolas, Cascadia Mono, Courier New"
                                                     TextAlignment="Center" Padding="2,2"
                                                     BorderThickness="0" Background="Transparent"
                                                     CaretBrush="{StaticResource AccentBrush}"
                                                     ToolTip="Minutes (00–59)"
                                                     Tag="StartMinute"
                                                     GotFocus="RaceStartMinute_GotFocus"
                                                     PreviewTextInput="RaceStartTimeDigit_PreviewTextInput"
                                                     PreviewKeyDown="RaceStartMinute_PreviewKeyDown"
                                                     LostFocus="RaceStartClockField_LostFocus"
                                                     KeyDown="RaceStartClockField_KeyDown"/>
                                            <TextBlock Text="00" FontSize="18" FontWeight="SemiBold"
                                                       FontFamily="Consolas, Cascadia Mono, Courier New"
                                                       Foreground="{StaticResource PlaceholderBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       IsHitTestVisible="False"
                                                       Visibility="{Binding ShowStartMinutePlaceholder, Converter={StaticResource BoolVis}}"/>
                                          </Grid>
                                        </StackPanel>
                                      </Border>
                                    </StackPanel>
                                  </DockPanel>
                                </Viewbox>
                              </Border>
                              <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                      Panel.ZIndex="2"
                                      Width="22" Height="22" Margin="0,2,2,0" Padding="0"
                                      FontSize="13" FontWeight="Bold" Content="×"
                                      Foreground="#C62828" Background="Transparent"
                                      BorderThickness="0" Cursor="Hand"
                                      KeyboardNavigation.IsTabStop="False"
                                      ToolTip="Delete Start Clock"
                                      Tag="{Binding}"
                                      Click="RemoveRaceStart_Click">
                                <Button.Template>
                                  <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="11"
                                            Width="{TemplateBinding Width}"
                                            Height="{TemplateBinding Height}">
                                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                  </ControlTemplate>
                                </Button.Template>
                              </Button>
                          </Grid>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <DockPanel>
      <!-- Header -->
      <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" Padding="20,14">
        <Grid>
          <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right"
                       FontSize="14" FontWeight="SemiBold" Margin="12,0,0,0"
                       Visibility="{Binding ShowAdminHeaderLink, Converter={StaticResource BoolVis}}"
                       ToolTip="Setup staff — PIN required">
              <Hyperlink Click="Admin_Click" Foreground="{StaticResource AccentBrush}"
                         TextDecorations="Underline" Cursor="Hand">Admin</Hyperlink>
            </TextBlock>
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right"
                       FontSize="14" FontWeight="SemiBold" Margin="12,0,0,0"
                       Visibility="{Binding ShowExitAdmin, Converter={StaticResource BoolVis}}"
                       ToolTip="Leave Admin and return to race day">
              <Hyperlink Click="ExitAdmin_Click" Foreground="{StaticResource AccentBrush}"
                         TextDecorations="Underline" Cursor="Hand">Exit Admin</Hyperlink>
            </TextBlock>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Image Source="pack://application:,,,/Assets/logo-mark.png"
                     Width="40" Height="40" Stretch="Uniform" Margin="0,0,14,0"
                     SnapsToDevicePixels="True"
                     RenderOptions.BitmapScalingMode="HighQuality"/>
              <TextBlock Text="Start 2 Finish Race Day Timing"
                         Foreground="White" FontSize="20" FontWeight="Bold"
                         VerticalAlignment="Center"/>
            </StackPanel>
          </DockPanel>
          <!-- Military laptop clock — top center; amber Check Clock only when sync is doubtful -->
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsHitTestVisible="False">
            <TextBlock Text="{Binding LaptopClockText}"
                       Foreground="White" FontSize="36" FontWeight="SemiBold"
                       FontFamily="Consolas, Cascadia Mono, Courier New"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding LaptopClockSyncLabel}"
                       Foreground="{Binding LaptopClockSyncBrush}"
                       FontSize="13" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,2,0,0"
                       Visibility="{Binding ShowLaptopClockWarning, Converter={StaticResource BoolVis}}"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Body -->
      <Grid Margin="28,20,28,12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <!-- Event name; actions claim most of the row when Timing Active. -->
            <ColumnDefinition Width="*" MinWidth="160"/>
            <ColumnDefinition Width="2*" MinWidth="360"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
          <TextBlock Text="{Binding StepTitle}" FontSize="28" FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding StepSubtitle}" Foreground="{StaticResource MutedBrush}"
                     FontSize="15" Margin="0,6,0,0" TextWrapping="Wrap"/>
          </StackPanel>
          <!-- Signed-in status on the title row, top-right — does not push the office list down. -->
          <Border Grid.Column="1" CornerRadius="8" Padding="14,8" Margin="20,2,0,0" MaxWidth="340"
                  BorderThickness="1"
                  Background="{Binding GraphReadyBannerBackground}"
                  BorderBrush="{Binding GraphReadyBannerBorder}"
                  VerticalAlignment="Top" HorizontalAlignment="Right"
                  Visibility="{Binding ShowGraphReadyInline, Converter={StaticResource BoolVis}}">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" FontSize="13" Text="{Binding GraphReadyLabel}"/>
              <TextBlock Text="{Binding GraphReadyInlineDetail}" FontSize="12" TextWrapping="Wrap"
                         Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
            </StackPanel>
          </Border>
          <!-- Timing Active: sticky actions stretch across ~2/3 of the title row -->
          <UniformGrid Grid.Column="1" Columns="3" VerticalAlignment="Top"
                       Margin="16,0,0,0"
                       Visibility="{Binding IsTimingActive, Converter={StaticResource BoolVis}}">
            <Button Content="Open RunScore" Style="{StaticResource PrimaryButton}"
                    MinHeight="52" FontSize="15" Margin="0,0,8,0"
                    HorizontalAlignment="Stretch"
                    IsEnabled="{Binding CanTapPrimaryActions}"
                    Click="LaunchRunScore_Click"/>
            <Button Content="Open Timing &amp; Scoring" Style="{StaticResource PrimaryButton}"
                    MinHeight="52" FontSize="15" Margin="0,0,8,0"
                    HorizontalAlignment="Stretch"
                    IsEnabled="{Binding CanTapPrimaryActions}"
                    Click="LaunchTs_Click"/>
            <Button Content="Finish" Style="{StaticResource SaveButton}"
                    MinHeight="52" FontSize="15"
                    HorizontalAlignment="Stretch"
                    IsEnabled="{Binding CanTapPrimaryActions}"
                    Click="Finish_Click"/>
          </UniformGrid>

          <!-- Role row: full width so Manual Backup Laptop is not clipped by the title column. -->
          <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,14,0,0"
                      VerticalAlignment="Center"
                      Visibility="{Binding ShowRolePicker, Converter={StaticResource BoolVis}}">
            <Button Content="Main Timing Laptop" MinWidth="200" Margin="0,0,10,0" Click="RoleTiming_Click">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsTimingRole}" Value="True">
                      <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                      <Setter Property="Foreground" Value="White"/>
                      <Setter Property="BorderThickness" Value="0"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button Content="Announcer T&amp;S Laptop" MinWidth="200" Margin="0,0,10,0" Click="RoleAnnouncer_Click">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsAnnouncerRole}" Value="True">
                      <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                      <Setter Property="Foreground" Value="White"/>
                      <Setter Property="BorderThickness" Value="0"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button Content="Manual Backup Laptop" MinWidth="200" Click="RoleManualBackup_Click">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsManualBackupRole}" Value="True">
                      <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                      <Setter Property="Foreground" Value="White"/>
                      <Setter Property="BorderThickness" Value="0"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
          </StackPanel>

          <!-- Timing Active sticky strip: Browse + Enable MB + tip -->
          <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0"
                     Visibility="{Binding IsTimingActive, Converter={StaticResource BoolVis}}">
            <Button DockPanel.Dock="Left" Content="Browse Race Files"
                    Style="{StaticResource SecondaryButton}"
                    MinHeight="36" MinWidth="168" Padding="12,6" Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Click="OpenWorkingFolder_Click"
                    ToolTip="Opens the local working copy of this race if you need to find a file."/>
            <Button DockPanel.Dock="Left" Content="Enable Manual Backup…"
                    Style="{StaticResource SecondaryButton}"
                    MinHeight="36" MinWidth="168" Padding="12,6" Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    Click="ConfigureManualBackup_Click"
                    ToolTip="Choose RunScore Results locations for Manual Backup."
                    Visibility="{Binding ManualBackup.ShowEnablePrompt, Converter={StaticResource BoolVis}}"/>
            <Border Background="#FFF4E8" BorderBrush="#E6C35C" BorderThickness="1"
                    CornerRadius="6" Padding="10,6">
              <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource InkBrush}"
                         VerticalAlignment="Center"
                         Text="Keep this app open all race — live OneDrive backup each minute. When done: close RunScore and Timing &amp; Scoring, then Finish above."/>
            </Border>
          </DockPanel>
        </Grid>

        <!-- OFFICE — signed-out banner (full width) + office list -->
        <DockPanel Grid.Row="1"
                   Visibility="{Binding IsOfficeStep, Converter={StaticResource BoolVis}}">
          <Border DockPanel.Dock="Top" CornerRadius="8" Padding="14,12" Margin="0,0,0,14"
                  BorderThickness="1"
                  Background="{Binding GraphReadyBannerBackground}"
                  BorderBrush="{Binding GraphReadyBannerBorder}"
                  Visibility="{Binding ShowGraphSignInBanner, Converter={StaticResource BoolVis}}">
            <DockPanel LastChildFill="True">
              <Button DockPanel.Dock="Right" Content="Sign In to OneDrive"
                      Style="{StaticResource PrimaryButton}"
                      MinHeight="40" MinWidth="180" Margin="16,0,0,0"
                      VerticalAlignment="Center" Click="GraphSignIn_Click"
                      ToolTip="Staff can sign in here — Admin PIN not required."/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"
                           Text="{Binding GraphReadyLabel}"/>
                <TextBlock Text="{Binding GraphLandingStatus}" FontSize="14" TextWrapping="Wrap"/>
              </StackPanel>
            </DockPanel>
          </Border>
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10"
                      Visibility="{Binding ShowRaceDayListFilter, Converter={StaticResource BoolVis}}">
            <TextBlock Text="{Binding RaceDayListFilterHint}" Margin="0,0,0,4"
                       Foreground="{StaticResource MutedBrush}" FontSize="12"/>
            <TextBox Text="{Binding RaceDayListFilter, UpdateSourceTrigger=PropertyChanged}"
                     Padding="10,8"
                     ToolTip="Filters the list as you type"/>
          </StackPanel>
          <ListBox x:Name="OfficeList"
                   Style="{StaticResource StepListBox}"
                   ItemsSource="{Binding VisibleOffices}"
                   MouseDoubleClick="Office_DoubleClick"
                   Visibility="{Binding ShowRaceDayOfficeList, Converter={StaticResource BoolVis}}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <!-- SESSION / EVENT -->
        <DockPanel Grid.Row="1" Visibility="{Binding IsSessionStep, Converter={StaticResource BoolVis}}">
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10"
                      Visibility="{Binding ShowRaceDayListFilter, Converter={StaticResource BoolVis}}">
            <TextBlock Text="{Binding RaceDayListFilterHint}" Margin="0,0,0,4"
                       Foreground="{StaticResource MutedBrush}" FontSize="12"/>
            <TextBox Text="{Binding RaceDayListFilter, UpdateSourceTrigger=PropertyChanged}"
                     Padding="10,8"
                     ToolTip="Filters the list as you type"/>
          </StackPanel>
          <Grid>
            <ListBox x:Name="SessionList"
                     Style="{StaticResource StepListBox}"
                     ItemContainerStyle="{StaticResource SessionListBoxItem}"
                     ItemsSource="{Binding SessionListView}"
                     SelectedItem="{Binding SelectedSession}"
                     Visibility="{Binding HasSessions, Converter={StaticResource BoolVis}}"
                     MouseDoubleClick="Session_DoubleClick">
              <ListBox.GroupStyle>
                <GroupStyle>
                  <GroupStyle.HeaderTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold"
                                 Foreground="{StaticResource MutedBrush}"
                                 Margin="2,14,0,8"/>
                    </DataTemplate>
                  </GroupStyle.HeaderTemplate>
                </GroupStyle>
              </ListBox.GroupStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <!-- Single-line row (matches Admin Events density). -->
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{Binding PrimaryEventFile}"
                               Foreground="{StaticResource MutedBrush}" FontSize="12"
                               VerticalAlignment="Center" Margin="12,0,0,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="220"
                               Visibility="{Binding DataContext.IsTimingRole, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Grid.Column="1" Text="{Binding SecondaryEventSummary}"
                               Foreground="{StaticResource MutedBrush}" FontSize="12"
                               VerticalAlignment="Center" Margin="12,0,0,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="220"
                               Visibility="{Binding DataContext.IsAnnouncerRole, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Grid.Column="2" Text="{Binding DisplayLock}" VerticalAlignment="Center"
                               FontSize="11" Margin="12,0,0,0"
                               Visibility="{Binding DataContext.ShowSessionLock, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                          <Setter Property="FontWeight" Value="Normal"/>
                          <Style.Triggers>
                            <!-- Checked out stays muted/grey — not danger/accent (those read as "pick me"). -->
                            <DataTrigger Binding="{Binding IsActivelyCheckedOut}" Value="True">
                              <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                              <Setter Property="FontWeight" Value="Normal"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480"
                        Visibility="{Binding ShowEmptySessions, Converter={StaticResource BoolVis}}">
              <TextBlock Text="{Binding EmptySessionsTitle}"
                         FontSize="20" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding EmptySessionsBody}" Margin="0,10,0,18" FontSize="14" TextAlignment="Center" TextWrapping="Wrap"
                         Foreground="{StaticResource MutedBrush}"/>
              <Button Content="Refresh Events" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Center" MinWidth="200" Click="RefreshSessions_Click"
                    ToolTip="Re-list this office from OneDrive (adds new events, drops ones moved to Past Races)."/>
            </StackPanel>
          </Grid>
        </DockPanel>

        <!-- EVENT FILE PICKER (main timing primary, or Announcer T&S secondary) -->
        <DockPanel Grid.Row="1" Visibility="{Binding IsEventFileStep, Converter={StaticResource BoolVis}}">
          <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,14"
                     Foreground="{StaticResource MutedBrush}" FontSize="15"
                     Text="{Binding EventFileStepHint}"/>
          <ListBox x:Name="EventFileList" Style="{StaticResource StepListBox}"
                   ItemsSource="{Binding EventFiles}"
                   SelectedItem="{Binding SelectedEventFile}"
                   MouseDoubleClick="EventFile_DoubleClick">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" FontSize="15"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <!-- ACTIVE Manual Backup role — Entry is the same Topmost float as Main Timing -->
        <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="10"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="28"
                Visibility="{Binding IsManualBackupActive, Converter={StaticResource BoolVis}}">
          <StackPanel VerticalAlignment="Center" MaxWidth="520" HorizontalAlignment="Center">
            <TextBlock Text="Manual Backup" FontSize="24" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock TextWrapping="Wrap" FontSize="15" TextAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"
                       Text="{Binding ManualBackup.Status}"/>
            <TextBlock TextWrapping="Wrap" FontSize="14" TextAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" Margin="0,0,0,22"
                       Text="Use the Manual Backup Entry window for bibs. Main Timing Plays them into RunScore Open."/>
            <Button Content="Open Entry Window" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Stretch" FontSize="18" MinHeight="56" Margin="0,0,0,12"
                    Click="OpenManualBackupFloat_Click"/>
            <Button Content="Done" Style="{StaticResource SaveButton}"
                    HorizontalAlignment="Stretch" FontSize="18" MinHeight="56"
                    Click="DoneManualBackup_Click"/>
          </StackPanel>
        </Border>

        <!-- ACTIVE timing — clocks fill left; Manual Backup is a compact right rail -->
        <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="10"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="12"
                Visibility="{Binding IsTimingActive, Converter={StaticResource BoolVis}}">
          <DockPanel>
              <!-- Another laptop took the lock — close vendors here, then Close Local Copy -->
              <Border DockPanel.Dock="Top" Background="#FDECEA" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                      CornerRadius="8" Padding="16" Margin="0,0,0,16"
                      Visibility="{Binding ShowLockTakenOverBanner, Converter={StaticResource BoolVis}}">

                <StackPanel>
                  <TextBlock Text="Another Laptop Took Over" FontSize="16" FontWeight="SemiBold"
                             Margin="0,0,0,8"/>
                  <TextBlock Text="{Binding LockTakenOverBannerText}" TextWrapping="Wrap" FontSize="14"
                             Margin="0,0,0,12"/>
                  <UniformGrid Columns="2" Margin="0,0,0,8">
                    <Button Content="Close RunScore" Style="{StaticResource PrimaryButton}"
                            Margin="0,0,8,8" Click="CloseRunScoreAfterTakeover_Click"/>
                    <Button Content="Close Timing &amp; Scoring" Style="{StaticResource PrimaryButton}"
                            Margin="8,0,0,8" Click="CloseTsAfterTakeover_Click"/>
                  </UniformGrid>
                  <Button Content="Close Local Copy" Style="{StaticResource SaveButton}"
                          HorizontalAlignment="Stretch"
                          Click="CloseLocalCopyAfterTakeover_Click"/>
                </StackPanel>
              </Border>

              <Border DockPanel.Dock="Bottom" Background="#F7F8FA" BorderBrush="{StaticResource LineBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,10,0,0"
                      Visibility="{Binding ShowActiveSaveAsGuide, Converter={StaticResource BoolVis}}">
                <StackPanel>
                  <TextBlock Text="T&amp;S Save As Path" FontSize="14" FontWeight="SemiBold"
                             Margin="0,0,0,6"/>
                  <TextBlock Text="{Binding ActiveSaveAsFolderGuide}"
                             FontFamily="Consolas, Cascadia Mono, Courier New"
                             FontSize="12" TextWrapping="Wrap"
                             Foreground="{StaticResource MutedBrush}"/>
                  <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"
                             Foreground="{StaticResource MutedBrush}"
                             Text="In Timing &amp; Scoring Save As, use This PC (not Documents) and save into this folder. Announcer / video files go here too — Finish uploads every .event in Active."/>
                </StackPanel>
              </Border>

              <!-- When MB on: Backup fills left; clocks stack on the right. When off: clocks center. -->
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Manual Backup — full remaining height on the left -->
                <Border Grid.Column="0" Margin="0,0,8,0" Padding="8,6"
                        Background="#FAFBFD" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                        CornerRadius="8" VerticalAlignment="Stretch"
                        Visibility="{Binding ManualBackup.ShowPanel, Converter={StaticResource BoolVis}}">
                  <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4" LastChildFill="True">
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Entry" Style="{StaticResource SecondaryButton}"
                                MinHeight="26" FontSize="11" Padding="8,2" Margin="0,0,4,0"
                                ToolTip="Open Entry Window"
                                Click="OpenManualBackupFloat_Click"/>
                        <Button Content="Settings" Style="{StaticResource SecondaryButton}"
                                MinHeight="26" FontSize="11" Padding="8,2"
                                ToolTip="Manual Backup Settings"
                                Click="ConfigureManualBackup_Click"/>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Manual Backup" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Border Padding="6,2" CornerRadius="3" BorderThickness="1" VerticalAlignment="Center">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Background" Value="#FDECEA"/>
                              <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding ManualBackup.OpenConnected}" Value="True">
                                  <Setter Property="Background" Value="#F3FBF6"/>
                                  <Setter Property="BorderBrush" Value="{StaticResource SaveBrush}"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <TextBlock Text="{Binding ManualBackup.OpenStatusText}" FontSize="10"
                                     VerticalAlignment="Center"/>
                        </Border>
                        <!-- Short status only (Play connection errors stay on the Alert dialog). -->
                        <TextBlock Text="{Binding ManualBackup.Status}" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                                   Margin="10,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                      </StackPanel>
                    </DockPanel>
                    <!-- Horizontal only — location header / device stay put; Past scrolls inside each column. -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  CanContentScroll="False">
                      <ItemsControl ItemsSource="{Binding ManualBackup.Locations}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Margin="0,0,6,0" Padding="0" CornerRadius="5" Width="230"
                                  Background="{StaticResource CardBrush}"
                                  BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                  ClipToBounds="True" VerticalAlignment="Top">
                            <DockPanel>
                              <!-- Sticky location header (does not scroll with Past). -->
                              <Border DockPanel.Dock="Top" Padding="5,3" Background="#F0F3F7"
                                      BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                                <DockPanel LastChildFill="True">
                                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Play All" Style="{StaticResource PrimaryButton}"
                                            MinHeight="22" FontSize="10" Padding="6,1" Margin="0,0,3,0"
                                            Click="ManualBackupPlayAll_Click" Tag="{Binding Location}"/>
                                    <Button Content="New File" Style="{StaticResource SecondaryButton}"
                                            MinHeight="22" FontSize="10" Padding="6,1"
                                            ToolTip="Create New File All"
                                            Click="ManualBackupCreateAll_Click" Tag="{Binding Location}"/>
                                  </StackPanel>
                                  <TextBlock Text="{Binding Location}" FontWeight="SemiBold" FontSize="11"
                                             VerticalAlignment="Center" TextWrapping="NoWrap"
                                             Margin="0,0,4,0"/>
                                </DockPanel>
                              </Border>
                              <ItemsControl ItemsSource="{Binding Devices}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Border Padding="4,3" BorderBrush="{StaticResource LineBrush}"
                                            BorderThickness="0,0,0,1" ClipToBounds="True">
                                      <DockPanel LastChildFill="True">
                                        <Border DockPanel.Dock="Left" Width="3" Margin="0,1,4,1" CornerRadius="1"
                                                Background="{StaticResource AccentBrush}" Opacity="0.55"/>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding DisplayName}"
                                                   Width="40" FontSize="10" FontWeight="SemiBold"
                                                   VerticalAlignment="Top" Margin="0,2,4,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DisplayName}"/>
                                        <!-- Current sticky; Past scrolls underneath -->
                                        <DockPanel LastChildFill="True">
                                          <Border DockPanel.Dock="Top" DataContext="{Binding CurrentFile}"
                                                  Padding="5,3" CornerRadius="4" Margin="0,0,0,4"
                                                  HorizontalAlignment="Stretch">
                                            <Border.Style>
                                              <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F7F8FA"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                  <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                    <Setter Property="Background" Value="#E5F6EC"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource SaveBrush}"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                    <DataTrigger.EnterActions>
                                                      <BeginStoryboard x:Name="MbCurPlayPulse">
                                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                          <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                           From="1" To="0.42" Duration="0:0:0.55"/>
                                                        </Storyboard>
                                                      </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                      <StopStoryboard BeginStoryboardName="MbCurPlayPulse"/>
                                                    </DataTrigger.ExitActions>
                                                  </DataTrigger>
                                                </Style.Triggers>
                                              </Style>
                                            </Border.Style>
                                            <StackPanel>
                                              <DockPanel LastChildFill="True" Margin="0,0,0,2">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                            VerticalAlignment="Center" Margin="6,0,0,0">
                                                  <Grid Width="20" Height="20" Margin="0,0,3,0">
                                                    <Button Content="&#xE768;" Style="{StaticResource IconToolButton}"
                                                            Width="20" Height="20" MinWidth="20" MinHeight="20"
                                                            FontSize="10" ToolTip="Play"
                                                            Visibility="{Binding ShowPlay, Converter={StaticResource BoolVis}}"
                                                            Click="ManualBackupPlayFile_Click" Tag="{Binding}"/>
                                                    <Button Content="&#xE769;" ToolTip="Pause"
                                                            Width="20" Height="20" MinWidth="20" MinHeight="20"
                                                            FontSize="10"
                                                            Visibility="{Binding ShowPause, Converter={StaticResource BoolVis}}"
                                                            Click="ManualBackupPause_Click" Tag="{Binding}">
                                                      <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource IconToolButton}">
                                                          <Setter Property="Background" Value="#FDECEA"/>
                                                          <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                                                          <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                          <Setter Property="Width" Value="20"/>
                                                          <Setter Property="Height" Value="20"/>
                                                          <Setter Property="MinWidth" Value="20"/>
                                                          <Setter Property="MinHeight" Value="20"/>
                                                          <Setter Property="FontSize" Value="10"/>
                                                        </Style>
                                                      </Button.Style>
                                                    </Button>
                                                  </Grid>
                                                  <Button Content="&#xE72C;" Style="{StaticResource IconToolButton}"
                                                          Width="20" Height="20" MinWidth="20" MinHeight="20"
                                                          FontSize="10" ToolTip="Replay"
                                                          Click="ManualBackupReplayFile_Click" Tag="{Binding}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Title, Mode=OneWay}" FontSize="11"
                                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                                           TextWrapping="NoWrap"/>
                                              </DockPanel>
                                              <TextBlock Text="{Binding CountLabel}" FontSize="10"
                                                         Foreground="{StaticResource MutedBrush}"/>
                                              <TextBlock Text="{Binding FirstTapLine}" FontSize="10"
                                                         FontFamily="Consolas" TextWrapping="NoWrap"
                                                         Foreground="{StaticResource MutedBrush}"/>
                                              <TextBlock Text="{Binding LastTapLine}" FontSize="10"
                                                         FontFamily="Consolas" TextWrapping="NoWrap"
                                                         Foreground="{StaticResource MutedBrush}"/>
                                            </StackPanel>
                                          </Border>
                                          <Expander Header="{Binding PastHeader}"
                                                    IsExpanded="{Binding PastExpanded, Mode=TwoWay}"
                                                    FontSize="11"
                                                    HorizontalAlignment="Stretch"
                                                    ExpandDirection="Down"
                                                    Visibility="{Binding HasArchives, Converter={StaticResource BoolVis}}">
                                            <ScrollViewer MaxHeight="280"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          CanContentScroll="False">
                                              <ItemsControl ItemsSource="{Binding Archives}" Margin="0,4,0,0"
                                                            HorizontalContentAlignment="Stretch">
                                                <ItemsControl.ItemContainerStyle>
                                                  <Style TargetType="ContentPresenter">
                                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                                  </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                  <DataTemplate>
                                                    <Border Margin="0,0,0,3" Padding="6,4" CornerRadius="3"
                                                            Background="#F7F8FA"
                                                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                                            HorizontalAlignment="Stretch" Opacity="0.92">
                                                      <Border.ContextMenu>
                                                        <ContextMenu>
                                                          <MenuItem Header="Delete Archive"
                                                                    Click="ManualBackupDeleteArchive_Click"
                                                                    Tag="{Binding}"/>
                                                        </ContextMenu>
                                                      </Border.ContextMenu>
                                                      <StackPanel>
                                                        <DockPanel LastChildFill="True" Margin="0,0,0,2">
                                                          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                                      VerticalAlignment="Center" Margin="4,0,0,0">
                                                            <Button Content="&#xE768;" Style="{StaticResource IconToolButton}"
                                                                    Width="18" Height="18" MinWidth="18" MinHeight="18"
                                                                    FontSize="9" ToolTip="Play" Margin="0,0,2,0"
                                                                    Click="ManualBackupPlayFile_Click" Tag="{Binding}"/>
                                                            <Button Content="&#xE72C;" Style="{StaticResource IconToolButton}"
                                                                    Width="18" Height="18" MinWidth="18" MinHeight="18"
                                                                    FontSize="9" ToolTip="Replay" Margin="0,0,2,0"
                                                                    Click="ManualBackupReplayFile_Click" Tag="{Binding}"/>
                                                            <Button Content="&#xE74D;" ToolTip="Delete Archive"
                                                                    Click="ManualBackupDeleteArchive_Click" Tag="{Binding}">
                                                              <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource IconToolButton}">
                                                                  <Setter Property="Width" Value="18"/>
                                                                  <Setter Property="Height" Value="18"/>
                                                                  <Setter Property="MinWidth" Value="18"/>
                                                                  <Setter Property="MinHeight" Value="18"/>
                                                                  <Setter Property="FontSize" Value="9"/>
                                                                  <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                </Style>
                                                              </Button.Style>
                                                            </Button>
                                                          </StackPanel>
                                                          <TextBlock Text="{Binding Title, Mode=OneWay}" FontSize="10"
                                                                     FontWeight="SemiBold" VerticalAlignment="Center"
                                                                     TextWrapping="NoWrap"
                                                                     Foreground="{StaticResource MutedBrush}"/>
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding CountLabel}" FontSize="9"
                                                                   Foreground="{StaticResource MutedBrush}"/>
                                                        <TextBlock Text="{Binding FirstTapLine}" FontSize="9"
                                                                   FontFamily="Consolas" TextWrapping="NoWrap"
                                                                   Foreground="{StaticResource MutedBrush}"/>
                                                        <TextBlock Text="{Binding LastTapLine}" FontSize="9"
                                                                   FontFamily="Consolas" TextWrapping="NoWrap"
                                                                   Foreground="{StaticResource MutedBrush}"/>
                                                      </StackPanel>
                                                    </Border>
                                                  </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                              </ItemsControl>
                                            </ScrollViewer>
                                          </Expander>
                                        </DockPanel>
                                      </DockPanel>
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </DockPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                  </DockPanel>
                </Border>

                <!-- Clocks rail (Manual Backup on): 2-col squares -->
                <DockPanel Grid.Column="1" Width="456" LastChildFill="True"
                           Visibility="{Binding ManualBackup.ShowPanel, Converter={StaticResource BoolVis}}">
                  <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" FontSize="13"
                             HorizontalAlignment="Left">
                    <Hyperlink Click="AddRaceStartClock_Click"
                               Foreground="{StaticResource AccentBrush}"
                               TextDecorations="Underline" Cursor="Hand"
                               ToolTip="Add Start Clock">Add New Clock</Hyperlink>
                  </TextBlock>
                  <ItemsControl x:Name="RaceStartBoardRail"
                                ItemsSource="{Binding RaceStartBoard}"
                                VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                ClipToBounds="True"
                                ItemTemplate="{StaticResource RaceStartClockTile}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <ctrl:EqualSquareGridPanel Columns="2"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                      <Style TargetType="ContentPresenter">
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="VerticalAlignment" Value="Stretch"/>
                      </Style>
                    </ItemsControl.ItemContainerStyle>
                  </ItemsControl>
                </DockPanel>

                <!-- Clocks center (Manual Backup off): squares shrink to fit -->
                <DockPanel Grid.Column="0" Grid.ColumnSpan="2" LastChildFill="True"
                           Visibility="{Binding ManualBackup.ShowPanel, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                  <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" FontSize="13"
                             HorizontalAlignment="Left">
                    <Hyperlink Click="AddRaceStartClock_Click"
                               Foreground="{StaticResource AccentBrush}"
                               TextDecorations="Underline" Cursor="Hand"
                               ToolTip="Add Start Clock">Add New Clock</Hyperlink>
                  </TextBlock>
                  <ItemsControl x:Name="RaceStartBoardList"
                                ItemsSource="{Binding RaceStartBoard}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                MaxWidth="1040"
                                ClipToBounds="True"
                                ItemTemplate="{StaticResource RaceStartClockTile}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <ctrl:EqualSquareGridPanel Columns="4"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                      <Style TargetType="ContentPresenter">
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="VerticalAlignment" Value="Stretch"/>
                      </Style>
                    </ItemsControl.ItemContainerStyle>
                  </ItemsControl>
                </DockPanel>
              </Grid>
          </DockPanel>
        </Border>

        <!-- ACTIVE announcer — stays open; Done uploads .event then clears this laptop -->
        <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="10"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="28"
                Visibility="{Binding IsAnnouncerActive, Converter={StaticResource BoolVis}}">
          <StackPanel>
            <Button Content="Open Timing &amp; Scoring" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Stretch" Margin="0,0,0,12" Click="LaunchTs_Click"
                    ToolTip="Opens the assigned announcer .event. You can open it again any time while this stays up."/>

            <Button Content="Browse Race Files" Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Left" Margin="0,0,0,28" Click="OpenWorkingFolder_Click"
                    ToolTip="Opens the local announcer copy, including DB's."/>

            <Border Background="#FFF8E8" BorderBrush="#E6C35C" BorderThickness="1"
                    CornerRadius="8" Padding="16" Margin="0,0,0,12">
              <TextBlock TextWrapping="Wrap" FontSize="14"
                         Text="Keep this app open while you announce. About every minute it pulls the race DB's folder (including announcer.csv) from OneDrive into this laptop so Timing &amp; Scoring can auto-load new participants. Open Timing &amp; Scoring again any time."/>
            </Border>

            <Border Background="#F3FBF6" BorderBrush="{StaticResource SaveBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16" Margin="0,0,0,16">
              <TextBlock TextWrapping="Wrap" FontSize="14"
                         Text="When you're finished, close Timing &amp; Scoring, then tap Done. Done uploads this laptop's .event to OneDrive, then removes the announcer files from this laptop. The timing laptop's checkout is not affected."/>
            </Border>

            <Button Content="Done" Style="{StaticResource SaveButton}"
                    HorizontalAlignment="Stretch" FontSize="18" MinHeight="56" Click="Done_Click"
                    ToolTip="Uploads the announcer .event to OneDrive, then clears this laptop."/>
          </StackPanel>
        </Border>

        <!-- ADMIN — Setup New Event | Edit Current Event | Settings -->
        <DockPanel Grid.Row="1" LastChildFill="True"
                   Visibility="{Binding IsAdminStep, Converter={StaticResource BoolVis}}">
          <!-- Tab strip — docked so lists fill like race-day (single scrollbar, no MaxHeight). -->
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Setup New Event" MinWidth="150" Margin="0,0,10,0" Click="AdminSetupNewEvent_Click">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsAdminSetupNewEvent}" Value="True">
                      <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                      <Setter Property="Foreground" Value="White"/>
                      <Setter Property="BorderThickness" Value="0"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button Content="Edit Current Event" MinWidth="160" Margin="0,0,10,0" Click="AdminEditCurrentEvent_Click">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsAdminEditCurrentEvent}" Value="True">
                      <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                      <Setter Property="Foreground" Value="White"/>
                      <Setter Property="BorderThickness" Value="0"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button Content="Settings" MinWidth="120" Click="AdminSettings_Click">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsAdminSettings}" Value="True">
                      <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                      <Setter Property="Foreground" Value="White"/>
                      <Setter Property="BorderThickness" Value="0"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
          </StackPanel>

          <Grid>
          <!-- Setup New Event — lists fill; forms scroll alone (no outer page scrollbar). -->
          <DockPanel LastChildFill="True"
                     Visibility="{Binding IsAdminSetupNewEvent, Converter={StaticResource BoolVis}}">
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Text="{Binding AdminNewEventBreadcrumb}" Foreground="{StaticResource MutedBrush}"
                         FontSize="13" Margin="0,0,0,10" TextWrapping="Wrap"/>
              <StackPanel Margin="0,0,0,10"
                          Visibility="{Binding ShowAdminListFilter, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding AdminListFilterHint}" Margin="0,0,0,4"
                           Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                <TextBox x:Name="NewEventListFilterBox"
                         Text="{Binding AdminListFilter, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10,8"
                         ToolTip="Filters the list as you type. Enter moves to the list."
                         KeyDown="AdminListFilter_KeyDown"/>
              </StackPanel>
            </StackPanel>
            <Grid>
              <ListBox x:Name="NewEventLayoutList"
                       Style="{StaticResource StepListBox}"
                       ItemsSource="{Binding NewEventLayouts}"
                       Visibility="{Binding IsAdminNewEventLayout, Converter={StaticResource BoolVis}}"
                       MouseDoubleClick="NewEventLayout_DoubleClick"
                       KeyDown="NewEventLayoutList_KeyDown">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <TextBlock Text="{Binding Display}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                 TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <ListBox x:Name="NewEventOfficeList"
                       Style="{StaticResource StepListBox}"
                       ItemsSource="{Binding NewEventOffices}"
                       Visibility="{Binding IsAdminNewEventOffice, Converter={StaticResource BoolVis}}"
                       MouseDoubleClick="NewEventOffice_DoubleClick"
                       KeyDown="NewEventOfficeList_KeyDown">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="15" FontWeight="SemiBold"/>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                            Visibility="{Binding IsAdminNewEventParent, Converter={StaticResource BoolVis}}">
                <StackPanel>
                  <TextBlock Text="Race Group Name" Margin="0,0,0,4" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                  <TextBox x:Name="NewEventParentNameBox"
                           Text="{Binding NewEventParentName, UpdateSourceTrigger=LostFocus}"
                           Padding="10,8" Margin="0,0,0,14" TabIndex="1"
                           ToolTip="Name only — e.g. LRM Weekend (do not type the year). Tab to Year, Enter to continue"
                           KeyDown="NewEventParentField_KeyDown"/>
                  <TextBlock Text="Year" Margin="0,0,0,4"
                             Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                  <TextBox x:Name="NewEventParentYearBox"
                           Text="{Binding NewEventParentYear, UpdateSourceTrigger=LostFocus}"
                           Padding="10,8" Margin="0,0,0,4" TabIndex="2"
                           HorizontalAlignment="Left" Width="100"
                           ToolTip="Year prefix on the Race Group folder (e.g. 2026). Enter to continue"
                           KeyDown="NewEventParentField_KeyDown"/>
                  <TextBlock Text="App adds the year — type the name only (folder becomes e.g. 2026 - LRM Weekend)."
                             FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                  <TextBlock Text="{Binding NewEventParentFolderPreview}" TextWrapping="Wrap" FontSize="13"
                             Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>
              </ScrollViewer>

              <ListBox x:Name="NewEventSourceKindList"
                       Style="{StaticResource StepListBox}"
                       ItemsSource="{Binding NewEventSourceKinds}"
                       Visibility="{Binding IsAdminNewEventSourceKind, Converter={StaticResource BoolVis}}"
                       MouseDoubleClick="NewEventSourceKind_DoubleClick"
                       KeyDown="NewEventSourceKindList_KeyDown">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Display}" FontSize="15" FontWeight="SemiBold"/>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <ListBox x:Name="NewEventSourceList"
                       Style="{StaticResource StepListBox}"
                       ItemsSource="{Binding NewEventSources}"
                       Visibility="{Binding IsAdminNewEventSource, Converter={StaticResource BoolVis}}"
                       MouseDoubleClick="NewEventSource_DoubleClick"
                       KeyDown="NewEventSourceList_KeyDown">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Display}" FontSize="15" FontWeight="SemiBold"/>
                      <TextBlock Text=" /" FontSize="15" FontWeight="SemiBold"
                                 Visibility="{Binding IsFolder, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                            Visibility="{Binding IsAdminNewEventDetails, Converter={StaticResource BoolVis}}">
                <StackPanel>
                  <TextBlock Text="Race Name" Margin="0,0,0,4" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                  <TextBox x:Name="NewEventRaceNameBox"
                           Text="{Binding NewEventRaceName, UpdateSourceTrigger=LostFocus}"
                           Padding="10,8" Margin="0,0,0,14" TabIndex="1"
                           ToolTip="Name only — do not type the year (app adds it from Race Date). Tab to Race Date."
                           KeyDown="NewEventDetailsField_KeyDown"/>

                  <TextBlock Text="Race Date" Margin="0,0,0,4" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                  <DatePicker x:Name="NewEventRaceDatePicker"
                              SelectedDate="{Binding NewEventRaceDateValue}"
                              Padding="8,6" MinHeight="36" Margin="0,0,0,4" TabIndex="2"
                              HorizontalAlignment="Left" Width="220"
                              ToolTip="Used in Entries.ini (MM/DD/YYYY) and the year in the folder name. Tab to Results ID."
                              KeyDown="NewEventDetailsField_KeyDown"/>
                  <TextBlock Text="Stored in Entries.ini as MM/DD/YYYY. Folder year comes from this date — do not put the year in Race Name."
                             FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14"/>

                  <TextBlock Text="%resultsid% (Race Roster)" Margin="0,0,0,4" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                  <TextBox x:Name="NewEventResultsIdBox"
                           Text="{Binding NewEventResultsId, UpdateSourceTrigger=LostFocus}"
                           Padding="10,8" Margin="0,0,0,4" TabIndex="3"
                           ToolTip="Paste the public results link or just the id. Enter creates the event."
                           KeyDown="NewEventDetailsField_KeyDown"/>
                  <TextBlock Text="Paste the full results.raceroster.com link or the id only — both work."
                             FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14"/>

                  <TextBlock Text="{Binding NewEventPreview}" TextWrapping="Wrap" FontSize="13"
                             Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>
              </ScrollViewer>

              <StackPanel Visibility="{Binding IsAdminNewEventGroupCreated, Converter={StaticResource BoolVis}}">
                <Border Background="#F3FBF6" BorderBrush="{StaticResource SaveBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="16" Margin="0,0,0,16">
                  <StackPanel>
                    <TextBlock Text="{Binding NewEventGroupCreatedHeadline}" FontSize="18" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding NewEventGroupCreatedDetail}" TextWrapping="Wrap" FontSize="14"
                               Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>
                    <TextBlock TextWrapping="Wrap" FontSize="14"
                               Text="Use Checkout to setup RunScore / T&amp;S for this event. Or Add Another Race to keep building under the same Race Group."/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </DockPanel>

          <!-- Edit Current Event — same fill pattern as Choose Your Event. -->
          <DockPanel LastChildFill="True"
                     Visibility="{Binding IsAdminEditCurrentEvent, Converter={StaticResource BoolVis}}">
            <!-- Match race-day: search only above the list. Path crumb only for Past Races drill-down. -->
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Text="{Binding AdminEventsBreadcrumb}" Foreground="{StaticResource MutedBrush}"
                         FontSize="13" Margin="0,0,0,10" TextWrapping="Wrap"
                         Visibility="{Binding ShowAdminEventsPathBreadcrumb, Converter={StaticResource BoolVis}}"/>
              <StackPanel Margin="0,0,0,10"
                          Visibility="{Binding ShowAdminListFilter, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding AdminListFilterHint}" Margin="0,0,0,4"
                           Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                <TextBox Text="{Binding AdminListFilter, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10,8"
                         ToolTip="Filters the list as you type"/>
              </StackPanel>
            </StackPanel>
            <Grid>
              <ListBox x:Name="AdminOfficeList"
                       Style="{StaticResource StepListBox}"
                       ItemsSource="{Binding AdminOffices}"
                       Visibility="{Binding IsAdminEventsOffice, Converter={StaticResource BoolVis}}"
                       MouseDoubleClick="AdminOffice_DoubleClick">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="15" FontWeight="SemiBold"/>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <ListBox x:Name="AdminSessionList"
                       Style="{StaticResource StepListBox}"
                       ItemsSource="{Binding AdminSessions}"
                       Visibility="{Binding IsAdminEventsSession, Converter={StaticResource BoolVis}}"
                       MouseDoubleClick="AdminSession_DoubleClick">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"/>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <DockPanel Visibility="{Binding IsAdminEventsAssign, Converter={StaticResource BoolVis}}">
                <!-- Main timing assignment stays above the scroll — not buried under Launch / Save As. -->
                <Border DockPanel.Dock="Top"
                        Background="#F3FBF6" BorderBrush="{StaticResource SaveBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="16" Margin="0,0,0,14"
                        Visibility="{Binding ShowAdminSaveAssignment, Converter={StaticResource BoolVis}}">
                  <StackPanel>
                    <TextBlock Text="Main Timing .event" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,0,0,10"
                               Text="Choose which .event is the primary timing file for this race, then Save Main Timing File. Other .event files (announcer, video) stay available on Announcer T&amp;S Laptop."/>
                    <ComboBox ItemsSource="{Binding AdminEventFiles}"
                              SelectedItem="{Binding SelectedTimingFile}"
                              Padding="8,6" MinHeight="40" Margin="0,0,0,12"/>
                    <Button Content="Save Main Timing File" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Stretch" MinHeight="48"
                            Click="SaveEventRoles_Click"
                            ToolTip="Saves which .event is main timing (local + OneDrive when signed in)."/>
                  </StackPanel>
                </Border>

                <Border DockPanel.Dock="Top"
                        Background="#F7F8FA" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="16" Margin="0,0,0,14"
                        Visibility="{Binding IsAdminEventsAssign, Converter={StaticResource BoolVis}}">
                  <StackPanel>
                    <TextBlock Text="Race Starts" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,0,0,12"
                               Text="Category and start time (24-hour, race-day date). Timers see these on checkout. On-site edits write back on Finish."/>
                    <ItemsControl ItemsSource="{Binding AdminRaceStarts}" Margin="0,0,0,12">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Category}" FontSize="15"
                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding StartDisplay}" FontSize="14"
                                       FontFamily="Consolas, Cascadia Mono, Courier New"
                                       Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center" Margin="12,0,16,0"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                              <Button Content="Edit" Style="{StaticResource SecondaryButton}"
                                      Padding="12,6" MinHeight="36" FontSize="13" Margin="0,0,6,0"
                                      Click="EditAdminRaceStart_Click"/>
                              <Button Content="Remove" Style="{StaticResource SecondaryButton}"
                                      Padding="12,6" MinHeight="36" FontSize="13"
                                      Click="RemoveAdminRaceStart_Click"/>
                            </StackPanel>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="0,0,0,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <TextBlock Grid.Row="0" Grid.Column="0" Text="Category Name" FontSize="12"
                                 Foreground="{StaticResource MutedBrush}" Margin="0,0,8,4"/>
                      <TextBlock Grid.Row="0" Grid.Column="1" Text="Start Time (24h)" FontSize="12"
                                 Foreground="{StaticResource MutedBrush}" Margin="0,0,8,4"/>
                      <TextBox Grid.Row="1" Grid.Column="0"
                               Text="{Binding NewAdminRaceStartCategory, UpdateSourceTrigger=PropertyChanged}"
                               FontSize="15" Padding="10,8" Margin="0,0,8,0"
                               KeyDown="NewAdminRaceStartField_KeyDown"/>
                      <TextBox Grid.Row="1" Grid.Column="1"
                               Text="{Binding NewAdminRaceStartTime, UpdateSourceTrigger=PropertyChanged}"
                               FontSize="15" Padding="10,8" Margin="0,0,8,0"
                               KeyDown="NewAdminRaceStartField_KeyDown"/>
                      <Button Grid.Row="1" Grid.Column="2" Content="{Binding AdminRaceStartCommitLabel}"
                              Style="{StaticResource SecondaryButton}"
                              Padding="16,8" MinHeight="40" Click="AddAdminRaceStart_Click"/>
                    </Grid>
                    <Button Content="Save Race Starts" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Stretch" MinHeight="48"
                            Click="SaveAdminRaceStarts_Click"
                            ToolTip="Writes race starts into the event pack and uploads to OneDrive when signed in."/>
                  </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,0,0,12"
                               Visibility="{Binding ShowAdminTsEmptyHint, Converter={StaticResource BoolVis}}"
                               Text="No Timing &amp; Scoring .event yet. Use Create a New Timing &amp; Scoring, Save As into the Active folder below, then Refresh Event Files and Save Main Timing File."/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,0,0,12"
                               Visibility="{Binding ShowAdminTsAddSecondaryHint, Converter={StaticResource BoolVis}}"
                               Text="Open Current opens the .event selected above. Create a New Timing &amp; Scoring starts blank so you can build an announcer / video file and Save As into the same Active folder."/>

                    <Button Content="Open Current Timing &amp; Scoring" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Stretch" MinHeight="48" Margin="0,0,0,10"
                            Click="AdminOpenCurrentTs_Click"
                            Visibility="{Binding ShowAdminTsAddSecondaryHint, Converter={StaticResource BoolVis}}"
                            ToolTip="Opens the .event selected as Main Timing (checks out this race if needed)."/>
                    <Button Content="Create a New Timing &amp; Scoring" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Stretch" MinHeight="48" Margin="0,0,0,10"
                            Click="AdminNewEmptyTs_Click"
                            Visibility="{Binding ShowAdminTsEmptyHint, Converter={StaticResource BoolVis}}"
                            ToolTip="Starts blank Timing &amp; Scoring. Save As the first .event into the Active folder below."/>
                    <Button Content="Create a New Timing &amp; Scoring" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Stretch" MinHeight="48" Margin="0,0,0,10"
                            Click="AdminNewEmptyTs_Click"
                            Visibility="{Binding ShowAdminTsAddSecondaryHint, Converter={StaticResource BoolVis}}"
                            ToolTip="Starts blank Timing &amp; Scoring for a new announcer / video .event. Save As into the Active folder below."/>

                    <Button Content="Refresh Event Files" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left" MinHeight="40" Margin="0,0,0,14"
                            Click="AdminRefreshEventFiles_Click"
                            ToolTip="Reload .event names from Active, Library, and OneDrive after Save As."/>
                    <Border Background="#F7F8FA" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="14" Margin="0,0,0,8"
                            Visibility="{Binding ShowAdminTsSetup, Converter={StaticResource BoolVis}}">
                      <StackPanel>
                        <TextBlock Text="T&amp;S Save As Path" FontSize="15" FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding AdminSaveAsFolderGuide}"
                                   FontFamily="Consolas, Cascadia Mono, Courier New"
                                   FontSize="13" TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}"/>
                      </StackPanel>
                    </Border>

                    <Border Background="#FFF8E8" BorderBrush="#E6C35C" BorderThickness="1"
                            CornerRadius="8" Padding="12" Margin="0,14,0,0"
                            Visibility="{Binding ShowAddRaceToGroup, Converter={StaticResource BoolVis}}">
                      <TextBlock TextWrapping="Wrap" FontSize="13"
                                 Text="This race sits under a Race Group. Use Add Race to This Race Group to create another event folder under the same group. Move to Past Races archives the whole Race Group."/>
                    </Border>
                  </StackPanel>
                </ScrollViewer>
              </DockPanel>
            </Grid>
          </DockPanel>

          <!-- Settings — one scrollbar for the form only. -->
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        Visibility="{Binding IsAdminSettings, Converter={StaticResource BoolVis}}">
            <StackPanel>
              <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,0,0,16"
                         Text="Library and race-day folders are fixed at C:\S2F\Library and C:\S2F\RaceDay (Graph cache + Active). New packs are under Setup New Event; main timing .event assignment is under Edit Current Event."/>

              <TextBlock Text="Software Installs" Margin="0,0,0,4" FontWeight="SemiBold"/>
              <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,0,0,10"
                         Text="Download or update race-day apps on this laptop. Each button opens the vendor page in your browser."/>
              <WrapPanel Margin="0,0,0,16">
                <Button Content="RunScore" Style="{StaticResource SecondaryButton}"
                        MinHeight="40" MinWidth="120" Margin="0,0,12,8"
                        Click="OpenSoftwareInstall_Click"
                        Tag="https://runscore.com/downloads"
                        ToolTip="Opens runscore.com/downloads"/>
                <Button Content="Timing &amp; Scoring" Style="{StaticResource SecondaryButton}"
                        MinHeight="40" MinWidth="160" Margin="0,0,12,8"
                        Click="OpenSoftwareInstall_Click"
                        Tag="https://portal.mylaps.com/s/downloads-timing-and-scoring"
                        ToolTip="Opens the MYLAPS Timing &amp; Scoring download page — partner login required"/>
                <Button Content="OBS" Style="{StaticResource SecondaryButton}"
                        MinHeight="40" MinWidth="100" Margin="0,0,12,8"
                        Click="OpenSoftwareInstall_Click"
                        Tag="https://obsproject.com/download"
                        ToolTip="Opens obsproject.com/download"/>
                <Button Content="VLC" Style="{StaticResource SecondaryButton}"
                        MinHeight="40" MinWidth="100" Margin="0,0,12,8"
                        Click="OpenSoftwareInstall_Click"
                        Tag="https://www.videolan.org/vlc/"
                        ToolTip="Opens videolan.org/vlc"/>
              </WrapPanel>

              <TextBlock Text="RunScore License" Margin="0,4,0,4" FontWeight="SemiBold"/>
              <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,0,0,10"
                         Text="On a new RunScore install: open RSServer → Help → Register RunScore → paste License Name and License Key → restart RunScore. These values load only from OneDrive ._s2f/runscore-vendor-secrets.json (not editable here). Sign in to refresh."/>
              <TextBlock Text="License Name" Margin="0,0,0,4" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
              <DockPanel Margin="0,0,0,8" LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="Copy" Style="{StaticResource SecondaryButton}"
                        MinHeight="40" MinWidth="88" Margin="12,0,0,0" Click="CopyRunScoreLicenseName_Click"
                        ToolTip="Copy License Name for Register RunScore"/>
                <TextBox Text="{Binding RunScoreLicenseName, Mode=OneWay}" Padding="10,8"
                         VerticalContentAlignment="Center" IsReadOnly="True"
                         Background="#F5F5F5"/>
              </DockPanel>
              <TextBlock Text="License Key" Margin="0,0,0,4" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
              <DockPanel Margin="0,0,0,16" LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="Copy" Style="{StaticResource SecondaryButton}"
                        MinHeight="40" MinWidth="88" Margin="12,0,0,0" Click="CopyRunScoreLicenseKey_Click"
                        ToolTip="Copy License Key for Register RunScore"/>
                <TextBox Text="{Binding RunScoreLicenseKey, Mode=OneWay}" Padding="10,8"
                         VerticalContentAlignment="Center" IsReadOnly="True"
                         Background="#F5F5F5"
                         FontFamily="Consolas"/>
              </DockPanel>

              <TextBlock Text="OneDrive" Margin="0,0,0,4" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding GraphAccountStatus}" TextWrapping="Wrap" Margin="0,0,0,8" FontSize="13"/>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Sign In to OneDrive" Style="{StaticResource PrimaryButton}"
                        MinHeight="40" Width="180" Margin="0,0,12,0" Click="GraphSignIn_Click"
                        Visibility="{Binding IsGraphSignedIn, Converter={StaticResource BoolVis}, ConverterParameter=invert}"/>
                <Button Content="Sign Out" Style="{StaticResource SecondaryButton}"
                        MinHeight="40" Width="120" Margin="0,0,12,0" Click="GraphSignOut_Click"
                        Visibility="{Binding IsGraphSignedIn, Converter={StaticResource BoolVis}}"/>
                <Button Content="Refresh Offices" Style="{StaticResource SecondaryButton}"
                        MinHeight="40" Width="150" Click="GraphRefresh_Click"
                        ToolTip="List office folders from OneDrive into C:\S2F\Library"/>
              </StackPanel>
              <Expander Header="Advanced" Margin="0,8,0,0"
                        Foreground="{StaticResource MutedBrush}">
                <StackPanel Margin="0,10,0,0">
                  <TextBlock Text="Cloud subfolder for the library (leave blank if offices are under My files)"
                             Margin="0,0,0,4" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                  <TextBox Text="{Binding GraphDriveRoot, UpdateSourceTrigger=PropertyChanged}" Padding="10,8"
                           Margin="0,0,0,12"
                           ToolTip="Blank = OneDrive My files root (Atlanta, Test Office, …). Only fill in if offices live inside a subfolder."/>

                  <TextBlock Text="RunScore Vendor Logins" Margin="0,4,0,4" FontWeight="SemiBold"/>
                  <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,10"
                             Text="Leave blank to use company credentials from OneDrive (._s2f/runscore-vendor-secrets.json). A custom login on this laptop is never overwritten by that file. SMS always uses the company file. Save, then restart RunScore if it is open."/>

                  <TextBlock Text="RaceRoster Login" Margin="0,0,0,4" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                  <TextBox Text="{Binding RaceRosterLoginOverride, UpdateSourceTrigger=PropertyChanged}" Padding="10,8"
                           Margin="0,0,0,8"/>
                  <TextBlock Text="RaceRoster Password" Margin="0,0,0,4" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                  <TextBox Text="{Binding RaceRosterPasswordOverride, UpdateSourceTrigger=PropertyChanged}" Padding="10,8"
                           Margin="0,0,0,12"
                           ToolTip="Optional when only changing the login — blank keeps the current RunScore password."/>

                  <TextBlock Text="RunSignUp Login" Margin="0,0,0,4" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                  <TextBox Text="{Binding RunSignUpLoginOverride, UpdateSourceTrigger=PropertyChanged}" Padding="10,8"
                           Margin="0,0,0,8"/>
                  <TextBlock Text="RunSignUp Password" Margin="0,0,0,4" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                  <TextBox Text="{Binding RunSignUpPasswordOverride, UpdateSourceTrigger=PropertyChanged}" Padding="10,8"
                           Margin="0,0,0,12"
                           ToolTip="Optional when only changing the login — blank keeps the current RunScore password."/>

                  <Button Content="Edit RunScore SOP…" Style="{StaticResource SecondaryButton}"
                          HorizontalAlignment="Left" MinWidth="200" Click="EditRunScoreSop_Click"
                          ToolTip="Opens runscore-sop.json — save the file, then checkout / Open RunScore to apply."/>
                </StackPanel>
              </Expander>
            </StackPanel>
          </ScrollViewer>

          </Grid>
        </DockPanel>

        <!-- Bottom actions + status (updates / library hints) -->
        <DockPanel Grid.Row="2" Margin="0,8,0,0" LastChildFill="True">
          <Button DockPanel.Dock="Left" Content="Back" Style="{StaticResource FooterSecondaryButton}"
                  Width="120" Margin="0,0,12,0" Click="Back_Click"
                  Visibility="{Binding ShowBack, Converter={StaticResource BoolVis}}"/>

          <!-- Admin actions sit in the shared footer (same row as race-day Continue) so lists get full height. -->
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"
                      Visibility="{Binding IsAdminStep, Converter={StaticResource BoolVis}}">
            <!-- IsDefault = Enter activates the visible primary action (lists + most fields). -->
            <Button Content="Continue" Width="160" Margin="0,0,12,0" Click="NewEventLayoutContinue_Click"
                    Visibility="{Binding IsAdminNewEventLayout, Converter={StaticResource BoolVis}}"
                    ToolTip="Enter — continue with the selected layout">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource FooterPrimaryButton}">
                  <Setter Property="IsDefault" Value="False"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsAdminNewEventLayout}" Value="True">
                      <Setter Property="IsDefault" Value="True"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button Content="Continue" Width="160" Margin="0,0,12,0" Click="NewEventOfficeContinue_Click"
                    Visibility="{Binding IsAdminNewEventOffice, Converter={StaticResource BoolVis}}"
                    ToolTip="Enter — continue with the selected office">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource FooterPrimaryButton}">
                  <Setter Property="IsDefault" Value="False"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsAdminNewEventOffice}" Value="True">
                      <Setter Property="IsDefault" Value="True"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button x:Name="NewEventParentContinueBtn" Content="Continue" Width="160" Margin="0,0,12,0"
                    Click="NewEventParentContinue_Click"
                    Visibility="{Binding IsAdminNewEventParent, Converter={StaticResource BoolVis}}"
                    ToolTip="Enter — confirm Race Group name and year">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource FooterPrimaryButton}">
                  <Setter Property="IsDefault" Value="False"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsAdminNewEventParent}" Value="True">
                      <Setter Property="IsDefault" Value="True"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button Content="Continue" Width="160" Margin="0,0,12,0" Click="NewEventSourceKindContinue_Click"
                    Visibility="{Binding IsAdminNewEventSourceKind, Converter={StaticResource BoolVis}}"
                    ToolTip="Enter — continue with the selected source">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource FooterPrimaryButton}">
                  <Setter Property="IsDefault" Value="False"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsAdminNewEventSourceKind}" Value="True">
                      <Setter Property="IsDefault" Value="True"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button Content="Continue" Width="160" Margin="0,0,12,0" Click="NewEventSourceContinue_Click"
                    Visibility="{Binding IsAdminNewEventSource, Converter={StaticResource BoolVis}}"
                    ToolTip="Enter — continue with the selected Template or past race">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource FooterPrimaryButton}">
                  <Setter Property="IsDefault" Value="False"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsAdminNewEventSource}" Value="True">
                      <Setter Property="IsDefault" Value="True"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button Content="Add Another Race to This Group" Style="{StaticResource FooterSecondaryButton}"
                    MinWidth="220" Margin="0,0,12,0" Click="NewEventAddAnother_Click"
                    Visibility="{Binding IsAdminNewEventGroupCreated, Converter={StaticResource BoolVis}}"
                    ToolTip="Stay in this Race Group and create the next race folder."/>
            <Button Content="{Binding NewEventCheckoutLastLabel}" MinWidth="180" Margin="0,0,12,0"
                    Click="NewEventCheckoutLast_Click"
                    Visibility="{Binding ShowNewEventGroupCheckout, Converter={StaticResource BoolVis}}"
                    ToolTip="Enter — check out the race you just created">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource FooterPrimaryButton}">
                  <Setter Property="IsDefault" Value="False"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ShowNewEventGroupCheckout}" Value="True">
                      <Setter Property="IsDefault" Value="True"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button x:Name="CreateNewEventBtn" Content="Create Event" MinWidth="160" Click="CreateNewEvent_Click"
                    Visibility="{Binding IsAdminNewEventDetails, Converter={StaticResource BoolVis}}"
                    ToolTip="Enter — create the event (from Results ID field, or when focus is not in a text box)">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource FooterPrimaryButton}">
                  <Setter Property="IsDefault" Value="False"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsAdminNewEventDetails}" Value="True">
                      <Setter Property="IsDefault" Value="True"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button Content="Save" Width="140" Click="SaveAdmin_Click"
                    Visibility="{Binding IsAdminSettings, Converter={StaticResource BoolVis}}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource FooterPrimaryButton}">
                  <Setter Property="IsDefault" Value="False"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsAdminSettings}" Value="True">
                      <Setter Property="IsDefault" Value="True"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button Content="Continue" Width="160" Margin="0,0,12,0" Click="AdminOfficeContinue_Click"
                    Visibility="{Binding IsAdminEventsOffice, Converter={StaticResource BoolVis}}"
                    ToolTip="Enter — continue with the selected office">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource FooterPrimaryButton}">
                  <Setter Property="IsDefault" Value="False"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsAdminEventsOffice}" Value="True">
                      <Setter Property="IsDefault" Value="True"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button Content="Continue" Width="160" Margin="0,0,12,0" Click="AdminSessionContinue_Click"
                    Visibility="{Binding IsAdminEventsSession, Converter={StaticResource BoolVis}}"
                    ToolTip="Enter — continue with the selected race">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource FooterPrimaryButton}">
                  <Setter Property="IsDefault" Value="False"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsAdminEventsSession}" Value="True">
                      <Setter Property="IsDefault" Value="True"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button Content="Choose Another Event" Style="{StaticResource FooterSecondaryButton}"
                    MinWidth="180" Margin="0,0,12,0" Click="AdminEventsStartOver_Click"
                    Visibility="{Binding IsAdminEventsAssign, Converter={StaticResource BoolVis}}"
                    ToolTip="Back to the office list to configure a different race."/>
            <Button Content="Add Race to This Race Group" Style="{StaticResource FooterSecondaryButton}"
                    MinWidth="220" Margin="0,0,12,0" Click="AdminAddRaceToGroup_Click"
                    Visibility="{Binding ShowAddRaceToGroup, Converter={StaticResource BoolVis}}"
                    ToolTip="Create another race folder under this Race Group."/>
            <Button Content="Move to Past Races" Style="{StaticResource FooterSecondaryButton}"
                    MinWidth="180" Margin="0,0,12,0" Click="AdminMoveToPastRaces_Click"
                    Visibility="{Binding ShowMoveToPastRaces, Converter={StaticResource BoolVis}}"
                    ToolTip="Move this race (or whole Race Group) from the live office into Past Races on OneDrive."/>
            <Button Content="Save Main Timing File" MinWidth="200" Click="SaveEventRoles_Click"
                    Visibility="{Binding ShowAdminSaveAssignment, Converter={StaticResource BoolVis}}"
                    ToolTip="Enter — save which .event is main timing">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource FooterPrimaryButton}">
                  <Setter Property="IsDefault" Value="False"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ShowAdminSaveAssignment}" Value="True">
                      <Setter Property="IsDefault" Value="True"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
          </StackPanel>

          <Button DockPanel.Dock="Right" Content="Continue" Style="{StaticResource FooterPrimaryButton}"
                  Width="160" Margin="12,0,0,0" Click="OfficeContinue_Click"
                  Visibility="{Binding IsOfficeStep, Converter={StaticResource BoolVis}}"/>
          <Button DockPanel.Dock="Right" Content="Continue" Style="{StaticResource FooterPrimaryButton}"
                  Width="160" Margin="12,0,0,0" Click="SessionContinue_Click"
                  Visibility="{Binding IsSessionStep, Converter={StaticResource BoolVis}}"/>
          <Button DockPanel.Dock="Right" Content="Refresh Events" Style="{StaticResource FooterSecondaryButton}"
                  Width="150" Margin="12,0,0,0" Click="RefreshSessions_Click"
                  Visibility="{Binding IsSessionStep, Converter={StaticResource BoolVis}}"
                  ToolTip="Re-list this office from OneDrive only — new events in, moved/Past Races events out."/>
          <Button DockPanel.Dock="Right" Content="Load Event" Style="{StaticResource FooterPrimaryButton}"
                  Width="160" Margin="12,0,0,0" Click="EventFileContinue_Click"
                  Visibility="{Binding IsEventFileStep, Converter={StaticResource BoolVis}}"/>
          <Button DockPanel.Dock="Right" Content="Check for Updates" Style="{StaticResource FooterSecondaryButton}"
                  Width="160" Margin="12,0,0,0" Click="CheckUpdates_Click"
                  Visibility="{Binding ShowCheckForUpdates, Converter={StaticResource BoolVis}}"
                  ToolTip="Download the latest S2F Race Day build when Wi‑Fi is available."/>

          <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}"
                     FontSize="12" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                     Margin="0,0,12,0"/>
        </DockPanel>
      </Grid>
    </DockPanel>

    <!-- Full-window busy / result overlay (no second Windows MessageBox) -->
    <Grid Visibility="{Binding Busy, Converter={StaticResource BoolVis}}" Panel.ZIndex="100">
      <Border Background="#E6000000"/>
      <Border Background="{StaticResource CardBrush}" CornerRadius="12"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Padding="40,36" MinWidth="420" MaxWidth="520"
              BorderBrush="{StaticResource AccentBrush}" BorderThickness="3">
        <StackPanel>
          <TextBlock Text="{Binding BusyTitle}" FontSize="26" FontWeight="Bold"
                     TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,14"/>
          <TextBlock Text="{Binding ProgressText}" FontSize="16"
                     Foreground="{StaticResource MutedBrush}"
                     TextAlignment="Center" TextWrapping="Wrap" LineHeight="24"/>
          <ProgressBar Height="6" Margin="0,22,0,0" IsIndeterminate="True"
                       Visibility="{Binding BusyKeepOpenVisible, Converter={StaticResource BoolVis}}"/>
          <TextBlock Text="Keep this window open — do not shut down yet." FontSize="14" FontWeight="SemiBold"
                     Foreground="{StaticResource AccentBrush}"
                     TextAlignment="Center" Margin="0,16,0,0"
                     Visibility="{Binding BusyKeepOpenVisible, Converter={StaticResource BoolVis}}"/>
          <Button Content="OK" Style="{StaticResource PrimaryButton}"
                  HorizontalAlignment="Stretch" Margin="0,28,0,0" MinHeight="52"
                  Visibility="{Binding BusyNeedsAcknowledge, Converter={StaticResource BoolVis}}"
                  Click="BusyOk_Click"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
