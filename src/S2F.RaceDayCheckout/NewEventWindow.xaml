<Window x:Class="S2F.RaceDayCheckout.NewEventWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New event"
        Height="560" Width="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Width="120" Margin="0,0,12,0"
              IsCancel="True" Click="Cancel_Click"/>
      <Button Content="Create event" Style="{StaticResource PrimaryButton}" Width="160"
              IsDefault="True" Click="Create_Click"/>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="New event from Template or prior year"
                   FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,18"
                   Text="Copies a Template or past race, writes Entries.ini, then checks the new event out so you can open RunScore / Timing &amp; Scoring."/>

        <TextBlock Text="Office" Margin="0,0,0,4" Foreground="{StaticResource MutedBrush}"/>
        <ComboBox x:Name="OfficeBox" Margin="0,0,0,14" Padding="8,6" MinHeight="36"/>

        <TextBlock Text="Copy from" Margin="0,0,0,4" Foreground="{StaticResource MutedBrush}"/>
        <ComboBox x:Name="SourceKindBox" Margin="0,0,0,8" Padding="8,6" MinHeight="36"
                  SelectionChanged="SourceKind_Changed">
          <ComboBoxItem Content="Templates folder" IsSelected="True"/>
          <ComboBoxItem Content="Past Races (office → year → race)"/>
        </ComboBox>
        <ComboBox x:Name="SourceBox" Margin="0,0,0,14" Padding="8,6" MinHeight="36"
                  DisplayMemberPath="Display" SelectedValuePath="Path"/>

        <TextBlock Text="Race name" Margin="0,0,0,4" Foreground="{StaticResource MutedBrush}"/>
        <TextBox x:Name="RaceNameBox" Margin="0,0,0,14" Padding="10,8"/>

        <TextBlock Text="Race date" Margin="0,0,0,4" Foreground="{StaticResource MutedBrush}"/>
        <TextBox x:Name="RaceDateBox" Margin="0,0,0,4" Padding="10,8"
                 ToolTip="Example: 10/17/2026 or Oct 17, 2026"/>
        <TextBlock Text="Stored in Entries.ini as MM/DD/YYYY. Year is used in the folder name."
                   FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14"/>

        <TextBlock Text="%resultsid% (Race Roster)" Margin="0,0,0,4" Foreground="{StaticResource MutedBrush}"/>
        <TextBox x:Name="ResultsIdBox" Margin="0,0,0,4" Padding="10,8"
                 ToolTip="Paste the public results link or just the id (e.g. xxu6s5mps2mhjpnh)"/>
        <TextBlock Text="Paste the full results.raceroster.com link or the id only — both work."
                   FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14"/>

        <TextBlock x:Name="PreviewBlock" TextWrapping="Wrap" FontSize="13"
                   Foreground="{StaticResource AccentBrush}"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
