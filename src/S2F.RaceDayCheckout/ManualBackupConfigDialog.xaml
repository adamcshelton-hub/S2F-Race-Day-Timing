<Window x:Class="S2F.RaceDayCheckout.ManualBackupConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mobile Backup"
        Width="420" Height="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F7F8FA">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancel" Width="100" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
      <Button Content="Save" Width="100" IsDefault="True" Click="Save_Click"/>
    </StackPanel>
    <StackPanel>
      <CheckBox x:Name="EnabledBox" Content="Enable Mobile Backup" FontSize="14" Margin="0,0,0,12"/>
      <TextBlock Text="Locations (comma-separated; match RunScore event names)" TextWrapping="Wrap" Margin="0,0,0,6"/>
      <TextBox x:Name="LocationsBox" AcceptsReturn="False" FontSize="14" Padding="8,6"/>
      <TextBlock Text="Example: Finish, 5K" Foreground="#666" Margin="0,8,0,0" FontSize="12"/>
    </StackPanel>
  </DockPanel>
</Window>
