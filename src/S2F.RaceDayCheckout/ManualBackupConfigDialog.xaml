<Window x:Class="S2F.RaceDayCheckout.ManualBackupConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manual Backup"
        Width="480" Height="560"
        MinWidth="420" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgBrush}">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Cancel" Style="{StaticResource SecondaryButton}" MinWidth="110" MinHeight="44"
              Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click"/>
      <Button Content="Save" Style="{StaticResource SaveButton}" MinWidth="110" MinHeight="44"
              IsDefault="True" Click="Save_Click"/>
    </StackPanel>
    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1" CornerRadius="10" Padding="16">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
          <Button DockPanel.Dock="Right" Content="Refresh" Style="{StaticResource SecondaryButton}"
                  MinHeight="30" FontSize="12" Padding="10,4" Click="Refresh_Click"
                  ToolTip="Re-read RunScore Results (Events.xml) from Active"/>
          <TextBlock Text="From RunScore Results" FontSize="13" FontWeight="SemiBold"
                     VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock DockPanel.Dock="Top"
                   Text="Same names as Results on the RunScore Master Menu. Check each location to use for Manual Backup. Save with none checked to turn Manual Backup off."
                   TextWrapping="Wrap" Margin="0,0,0,10" FontSize="12"
                   Foreground="{StaticResource MutedBrush}"/>
        <TextBlock DockPanel.Dock="Bottom" x:Name="EmptySuggestText"
                   Text="No RunScore Results found in Active RUNSCORE (Events.xml / *.FN2). Open the race in RunScore, then tap Refresh."
                   Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,0"
                   TextWrapping="Wrap" Visibility="Collapsed"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="SuggestList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}"
                          FontSize="15" Margin="0,0,0,8" MinHeight="22"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </DockPanel>
</Window>
